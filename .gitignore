/target/
**/target/
**/__pycache__/
*.py[cod]
.pytest_cache/
.mypy_cache/
/dist/
/wheelhouse/

# Generated validation runs are reproducible from the tracked scripts and data.
/validation/**/runs/
/validation/**/feasibility/
/validation/**/benchmark/runs/
/validation/**/benchmark/figures/
/validation/2026-07-29_0.4.2-dev_lazy_exact_sample000/

# SLURM job logs: run artefacts, not source.
/validation/**/logs/
/validation/**/*.out

# Third-party benchmark inputs (ImmuneApp supplementary tables). Not ours to
# redistribute; see validation/*/mhc_bench_data/SOURCES.md for how to obtain them.
/validation/**/mhc_bench_data/*.xlsx

# Third-party benchmark tools (MixMHCp clone, conda env). Installed locally by
# benchmark/README.md; not ours to redistribute.
/validation/**/benchmark/tools/

# Motif grid shards and GibbsCluster shard output: regenerated by the sbatch
# scripts beside them.
/validation/**/grid/
/validation/**/raw/gibbs_shards/

# SLURM logs written to the repo root by sbatch --output=logs/...
/logs/
